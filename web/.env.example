# Copy to .env and fill in. Never commit .env — it is gitignored.
# Anything prefixed VITE_ is embedded in the client bundle and is PUBLIC.
# The anon key is safe to expose; the service-role key is NOT and belongs in server/.env.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (Project Settings → API).
VITE_SUPABASE_ANON_KEY=

# Where the VisioNotes backend is running.
VITE_API_URL=http://localhost:3002
