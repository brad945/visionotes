# Python virtual environment (machine-specific, rebuildable)
.venv/
__pycache__/
*.pyc

# MediaPipe model files (large binaries, re-downloadable)
*.task

# macOS junk
.DS_Store

# Dependencies (rebuildable via npm install)
node_modules/

# Build output
dist/

# Editor
.vscode/

# Local-only Claude Code skills/tooling (not part of the app)
.claude/
.impeccable/

# Secrets / environment variables (NEVER commit)
.env
.env.*
*.env

# ...except the templates, which carry no secrets and document required config.
!.env.example
!**/.env.example
