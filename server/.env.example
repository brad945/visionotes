# Copy to .env and fill in. Never commit .env — it is gitignored.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service-role key (Project Settings → API). Bypasses RLS — server-side ONLY,
# never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Port this API listens on.
PORT=3002

# Comma-separated list of browser origins allowed to call this API.
# Defaults to http://localhost:5173 when unset.
ALLOWED_ORIGINS=http://localhost:5173

# Max JSON request body. Must match the default in index.js — this file said 2mb
# while the code defaulted to 1mb, so anyone who followed the docs ran a limit
# that was never tested. Replay frames arrive in bounded chunks now, so 1mb is a
# ceiling on ONE chunk, not on a whole session; raising it should not be needed.
JSON_BODY_LIMIT=1mb
